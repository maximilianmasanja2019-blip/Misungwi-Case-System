    <!-- ==================== SYSTEM JAVASCRIPT ARCHITECTURE ==================== -->
    <script>
        // Database Architecture (Persistent LocalStorage Database System)
        const DEFAULT_DATA = {
            region: "Mwanza",
            district: "Misungwi",
            districtCourt: "Mahakama ya Wilaya ya Misungwi",
            primaryCourts: [
                {
                    code: "MIS-PMC-INONELWA",
                    name: "MAHAKAMA YA MWANZO INONELWA",
                    type: "Primary Court",
                    parentDistrict: "Misungwi District",
                    region: "Mwanza",
                    ward: "Inonelwa",
                    status: "Active",
                    createdDate: "2026-01-15"
                }
            ],
            cases: [
                { id: "MIS/CIV/01/2026", parties: "John Doe vs Jane Doe", court: "Mahakama ya Wilaya ya Misungwi", type: "Civil", status: "Pending" },
                { id: "INON/CRIM/04/2026", parties: "Jamhuri vs Juma Hamisi", court: "MAHAKAMA YA MWANZO INONELWA", type: "Criminal", status: "Completed" }
            ]
        };

        // Load data from LocalStorage or seed default
        function getDB() {
            const data = localStorage.getItem('misungwi_court_db');
            if (!data) {
                localStorage.setItem('misungwi_court_db', JSON.stringify(DEFAULT_DATA));
                return DEFAULT_DATA;
            }
            return JSON.parse(data);
        }

        function saveDB(data) {
            localStorage.setItem('misungwi_court_db', JSON.stringify(data));
        }

        // Global State Variables
        let currentUser = null;

        // Populate Court Select Options dynamically
        function toggleCourtSelect() {
            const role = document.getElementById('login-role').value;
            const container = document.getElementById('primary-court-select-container');
            const select = document.getElementById('login-court-code');

            if (role === 'primary') {
                container.classList.remove('hidden');
                const db = getDB();
                select.innerHTML = db.primaryCourts.map(pc => `<option value="${pc.code}">${pc.name} (${pc.code})</option>`).join('');
            } else {
                container.classList.add('hidden');
            }
        }

        // Handle Login Logic
        function handleLogin(e) {
            e.preventDefault();
            const role = document.getElementById('login-role').value;
            const username = document.getElementById('login-username').value;
            const db = getDB();

            if (role === 'admin') {
                currentUser = { name: username, role: 'System Administrator', type: 'admin', court: 'Misungwi District HQ' };
            } else if (role === 'district') {
                currentUser = { name: username, role: 'District Magistrate / Clerk', type: 'district', court: db.districtCourt };
            } else {
                const code = document.getElementById('login-court-code').value;
                const pc = db.primaryCourts.find(p => p.code === code);
                currentUser = { name: username, role: 'Primary Court Officer', type: 'primary', court: pc ? pc.name : 'Primary Court' };
            }

            // UI Adjustments
            document.getElementById('login-screen').classList.add('hidden');
            document.getElementById('main-system').classList.remove('hidden');

            document.getElementById('user-display-name').innerText = currentUser.name;
            document.getElementById('user-display-role').innerText = currentUser.role;
            document.getElementById('header-court-title').innerText = currentUser.court;

            // Permissions Control
            const adminElements = document.querySelectorAll('.admin-only');
            adminElements.forEach(el => {
                if (currentUser.type === 'admin') el.classList.remove('hidden');
                else el.classList.add('hidden');
            });

            renderDashboard();
            renderStationsTable();
            renderCasesTable();
        }

        // Logout Procedure
        function logout() {
            currentUser = null;
            document.getElementById('main-system').classList.add('hidden');
            document.getElementById('login-screen').classList.remove('hidden');
        }

        // Render Dashboard Statistics Dynamic Cards
        function renderDashboard() {
            const db = getDB();
            const container = document.getElementById('stat-cards-container');
            const title = document.getElementById('dash-title');

            if (currentUser.type === 'admin' || currentUser.type === 'district') {
                title.innerText = "MAHAKAMA YA WILAYA YA MISUNGWI - OVERVIEW";
                container.innerHTML = `
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-blue-900">
                        <p class="text-xs text-gray-500 font-bold uppercase">Total Primary Courts</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">${db.primaryCourts.length}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-amber-500">
                        <p class="text-xs text-gray-500 font-bold uppercase">Total Cases (Mashauri)</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">${db.cases.length}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-green-500">
                        <p class="text-xs text-gray-500 font-bold uppercase">Active System Stations</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">${db.primaryCourts.filter(c => c.status === 'Active').length}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-purple-500">
                        <p class="text-xs text-gray-500 font-bold uppercase">District System Users</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">Authorized</p>
                    </div>
                `;
            } else {
                title.innerText = currentUser.court;
                const courtCases = db.cases.filter(c => c.court === currentUser.court);
                container.innerHTML = `
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-blue-900">
                        <p class="text-xs text-gray-500 font-bold uppercase">My Cases</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">${courtCases.length}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-amber-500">
                        <p class="text-xs text-gray-500 font-bold uppercase">Pending Cases</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">${courtCases.filter(c => c.status === 'Pending').length}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-green-500">
                        <p class="text-xs text-gray-500 font-bold uppercase">Completed Cases</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">${courtCases.filter(c => c.status === 'Completed').length}</p>
                    </div>
                    <div class="bg-white p-4 rounded-lg shadow border-l-4 border-red-500">
                        <p class="text-xs text-gray-500 font-bold uppercase">Shared Documents</p>
                        <p class="text-2xl font-black text-gray-800 mt-1">0</p>
                    </div>
                `;
            }
        }

        // Render Primary Court Stations Table
        function renderStationsTable() {
            const db = getDB();
            const tbody = document.getElementById('stations-table-body');
            tbody.innerHTML = db.primaryCourts.map(pc => `
                <tr class="hover:bg-gray-50">
                    <td class="p-3 font-mono text-blue-900 font-bold">${pc.code}</td>
                    <td class="p-3 font-bold text-gray-800">${pc.name}</td>
                    <td class="p-3">${pc.type}</td>
                    <td class="p-3">${pc.ward}</td>
                    <td class="p-3">${pc.parentDistrict}</td>
                    <td class="p-3"><span class="bg-green-100 text-green-800 px-2 py-0.5 rounded text-[10px] font-bold">${pc.status}</span></td>
                    <td class="p-3 text-center admin-only">
                        <button onclick="toggleStationStatus('${pc.code}')" class="text-xs text-blue-700 hover:underline font-bold">Badili Hali</button>
                    </td>
                </tr>
            `).join('');
        }

        // Render Cases Table
        function renderCasesTable() {
            const db = getDB();
            const tbody = document.getElementById('cases-table-body');
            tbody.innerHTML = db.cases.map(c => `
                <tr class="hover:bg-gray-50">
                    <td class="p-3 font-mono font-bold text-blue-900">${c.id}</td>
                    <td class="p-3 font-medium">${c.parties}</td>
                    <td class="p-3">${c.court}</td>
                    <td class="p-3">${c.type}</td>
                    <td class="p-3"><span class="px-2 py-0.5 text-[10px] rounded font-bold ${c.status === 'Pending' ? 'bg-amber-100 text-amber-800' : 'bg-green-100 text-green-800'}">${c.status}</span></td>
                </tr>
            `).join('');
        }

        // Modal Handlers
        function openAddStationModal() {
            document.getElementById('add-station-modal').classList.remove('hidden');
        }

        function closeAddStationModal() {
            document.getElementById('add-station-modal').classList.add('hidden');
        }

        // Save New Primary Court / Station dynamically (Admin Action)
        function saveNewStation(e) {
            e.preventDefault();
            const db = getDB();
            
            const newStation = {
                code: document.getElementById('new-station-code').value.trim(),
                name: document.getElementById('new-station-name').value.trim(),
                type: "Primary Court",
                parentDistrict: "Misungwi District",
                region: "Mwanza",
                ward: document.getElementById('new-station-ward').value.trim(),
                status: "Active",
                createdDate: new Date().toISOString().split('T')[0]
            };

            db.primaryCourts.push(newStation);
            saveDB(db);

            alert('Mahakama / Kituo kipya kimesajiliwa kikamilifu bila kubadili code!');
            closeAddStationModal();
            renderStationsTable();
            renderDashboard();
            toggleCourtSelect();
        }

        // Toggle Station Active/Inactive Status
        function toggleStationStatus(code) {
            const db = getDB();
            const court = db.primaryCourts.find(c => c.code === code);
            if (court) {
                court.status = court.status === 'Active' ? 'Inactive' : 'Active';
                saveDB(db);
                renderStationsTable();
                renderDashboard();
            }
        }

        // Tab Navigation Router
        function switchTab(tabId) {
            document.querySelectorAll('.tab-content').forEach(tab => tab.classList.add('hidden'));
            document.querySelectorAll('nav button').forEach(btn => btn.classList.remove('sidebar-item-active', 'text-white'));

            document.getElementById(`tab-${tabId}`).classList.remove('hidden');
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) activeNav.classList.add('sidebar-item-active', 'text-white');
        }

        // Init on load
        toggleCourtSelect();
    </script>
</body>
</html>
